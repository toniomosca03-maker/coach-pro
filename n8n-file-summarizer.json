      "parameters": {
        "jsCode": "// Genera nome file dinamico con data e ora corrente\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst day = String(now.getDate()).padStart(2, '0');\nconst hours = String(now.getHours()).padStart(2, '0');\nconst minutes = String(now.getMinutes()).padStart(2, '0');\n\nconst filename = `riassunto_${year}-${month}-${day}_${hours}-${minutes}.txt`;\n\n// Recupera il testo del riassunto dall'output della chain\nconst summaryText = $input.first().json.response \n  || $input.first().json.text \n  || $input.first().json.output \n  || 'Nessun riassunto generato.';\n\nreturn [\n  {\n    json: {\n      filename: filename,\n      summaryText: summaryText,\n      outputPath: `C:/N8N_PROD/${filename}`\n    }\n  }\n];"
      },
